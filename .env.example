# Local development can run without these. Production must set SESSION_SECRET.

SESSION_SECRET=

# Optional override. Defaults to ./data
CLIPFORGE_DATA_DIR=

# Max upload size in bytes. Defaults to 200MB.
MAX_UPLOAD_BYTES=209715200

# Supabase Auth and Postgres. Leave blank to use the local signed session and data/db.json.
# The publishable key name matches the current Supabase server-auth guide.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2. Leave blank to store uploads and renders on local disk.
# Endpoint used by the app: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Gemini video understanding. Leave blank to skip highlight detection.
# The app uses the official Interactions API and does not call Gemini without this key.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.5-flash

# Optional YouTube Data API key for duration and channel metadata.
# oEmbed still supplies title, creator, and thumbnail without this key.
YOUTUBE_API_KEY=

# Optional overrides. Defaults to the ffmpeg-static and ffprobe-static binaries.
FFMPEG_PATH=
FFPROBE_PATH=
